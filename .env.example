# Copy to .env.local and fill in values. Never commit .env.local (gitignored).
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# From BotFather when you created the bot
TELEGRAM_BOT_TOKEN=
# Local dev default. After Vercel deploy, set to https://<your-app>.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Any long random string you invent (used as ?key=... for /admin)
ADMIN_SECRET=
